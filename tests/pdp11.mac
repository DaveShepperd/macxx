abs == 6666
off == 1234
imm == 7777

.macro op1reg op
	.irp reg,<r0,r1,r2,r3,r4,r5,sp,pc>
	op reg
	.endr
.endm
.macro op1dest op nor0=0
   .irp reg,<r0,r1,r2,r3,r4,r5,sp,pc>
	.if eq,nor0
	op reg
	.endc
	op (reg)
	op (reg)+
	op @(reg)+
	op -(reg)
	op @-(reg)
	op off(reg)
	op @off(reg)
	.endr
.endm

