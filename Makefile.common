CORE0 = symbol.o hashit.o memmgt.o dumdir.o dummy.o opcnds.o err2str.o add_defs.o utils.o
CORE1 = debug.o help.o 
CORE2 = macxx.o gc_table.o gc.o opcode.o
CORE3 = endlin.o outx.o pass2.o macros.o psuedo_ops.o
CORE4 = listctrl.o sortsym.o stack_ops.o qksort.o
EXPx  = le_itfc.o lib_exprs.o
PASSx = pass0.o pass1.o
MOST = $(CORE0) $(CORE1) $(CORE2) $(CORE3) $(CORE4)

ALLO65   = exprs65.o char_tbl65.o opc65.o pst65.o             $(MOST) $(PASSx) $(EXPx)
ALLO68   = exprs68.o char_tbl65.o opc68.o pst68.o             $(MOST) $(PASSx) $(EXPx)
ALLO69   = exprs69.o char_tbl65.o opc69.o pst69.o             $(MOST) $(PASSx) $(EXPx)
ALLO11   = exprs11.o char_tbl65.o opc11.o pst11.o m11types.o  $(MOST) $(PASSx) $(EXPx)
ALLO8080 = exprs.o char_table.o opc8080.o pst8080.o           $(MOST) $(PASSx) $(EXPx)
ALLOAS   = exprs.o char_table.o opcas.o pstas.o dummy_pass0.o pass1.o $(MOST) $(EXPx)
ALLOTJ   = exprs.o char_table.o opctj.o psttj.o dummy_pass0.o pass1.o $(MOST) $(EXPx)
ALLO68K  = exprs68k.o char_table.o opc68k.o pst68k.o m68types.o dummy_pass0.o pass168k.o $(MOST)

ALLOPP0 = macxx_pp.o pass1_pp.o lstctlpp.o opcode_pp.o
ALLOPP1 = gc_tblpp.o gc_pp.o exprs_pp.o macros_pp.o
ALLOPP2 = psdo_ops_pp.o pstpp.o opcpp.o char_table.o
ALLOPP3 = help_pp.o $(CORE0)

ALLH = structs.h header.h ct.h token_defs.h token.h

HERE = ./
EXE =
ifeq ($(MINGW),1)
	EXE = .exe
	HERE = .\\
endif
ifeq ($(MSYS2),1)
	EXE = .exe
endif

# For Generic Unix/x86
DEFINES = -DEXTERNAL_PACKED_STRUCTS -DM_UNIX -DINCLUDE_FLOAT -DNO_XREF -DGCC -DHAS_STRERROR -D_ISOC99_SOURCE #-DPC_DEBUG #-DMAX_LINE_ERRORS=12 #-DDEBUG_TXT_INP
DEFINES += $(EXTRA_DEFINES)
CHKS = -Wall -ansi -pedantic -Wno-char-subscripts #-std=c99
CHKS += $(EXTRA_CHKS)
CFLAGS = $(OPT) $(DBG) $(DEFINES) $(HOST_CPU) -I. $(CHKS)
L = $(CC) $(HOST_CPU)
C = $(CC) -c $(CFLAGS) 
MAKEFILE = Makefile.common

.SILENT:

ifeq ($(MINGW),1)

%.o : %.c
	$(ECHO) $(DELIM)    Compiling $<...$(DELIM)
	$C -o $@ $<
else

%.o : %.c
	$(ECHO) $(DELIM)    Compiling $<...$(DELIM);\
	rm -f $(basename $@).err $(basename $@).warn;\
	$C -o $@ $< > $(basename $@).err 2>&1;\
	if [ $$? -ne 0 ]; then\
	    $(ECHO) $(DELIM)Errors in $(basename $@).err$(DELIM);\
	    cat $(basename $@).err;\
	else\
	    if [ -s $(basename $@).err ]; then\
	        mv $(basename $@).err $(basename $@).warn;\
	        $(ECHO) $(DELIM)Warnings in $(basename $@).warn$(DELIM);\
	        cat $(basename $@).warn;\
            else\
	        rm -f $(basename $@).err;\
	    fi;\
	fi

endif    

%.E : %.c
	$(ECHO) $(DELIM)    Compiling $< to $@ ...$(DELIM)
	$(CC) $(CFLAGS) -E $< > $@

all : macas$(EXE) mac65$(EXE) mac68$(EXE) mac68k$(EXE) mac69$(EXE) macpp$(EXE) mactj$(EXE) mac11$(EXE) mac8080$(EXE)
	$(ECHO) $(DELIM)    Done$(DELIM)

define link_it
	$(ECHO) $(DELIM)    linking $@...$(DELIM)
	$L $(DBG) -o $@ $(filter-out $(MAKEFILE),$^)
endef

macpp$(EXE) : $(MAKEFILE) $(ALLOPP0) $(ALLOPP1) $(ALLOPP2) $(ALLOPP3) 
	$(link_it)

mactj$(EXE) : $(MAKEFILE) $(ALLOTJ) 
	$(link_it)

mac8080$(EXE) : $(MAKEFILE) $(ALLO8080) 
	$(link_it)

mac65$(EXE) : $(MAKEFILE) $(ALLO65) 
	$(link_it)

mac68$(EXE):  $(MAKEFILE) $(ALLO68)
	$(link_it)

mac68k$(EXE) : $(MAKEFILE) $(ALLO68K) 
	$(link_it)

mac69$(EXE):  $(MAKEFILE) $(ALLO69)
	$(link_it)

macas$(EXE) : $(MAKEFILE) $(ALLOAS) 
	$(link_it)

mac11$(EXE) : $(MAKEFILE) $(ALLO11)
	$(link_it)

dmpod$(EXE) : dmpod.o
	$(link_it)

