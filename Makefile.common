mk_operstuff.o : mk_operstuff.c Makefile.common
	$(ECHO) $(DELIM)    Compiling $<...$(DELIM)
	$C -o $@ $<

mk_operstuff$(EXE) : mk_operstuff.o Makefile.common
	$(link_it)

operstuff.h : operstuff.dat mk_operstuff$(EXE) Makefile.common
	$(ECHO) $(DELIM)    Making $@ ...$(DELIM)
	$(HERE)mk_operstuff > $@

lib_exprs.o : lib_exprs.c lib_exprs.h operstuff.h
	$(ECHO) $(DELIM)    Compiling $< ...$(DELIM)
	$C -D_FMT_LD_='"%d"' -DNO_FLOATING_POINT -o $@ $<

pass168k.o : pass1.c token.h token_defs.h structs.h add_defs.h header.h memmgt.h ct.h qual_tbl.h \
  pst_tokens.h pst_structs.h listctrl.h lstcnsts.h strsub.h exproper.h
	$(ECHO) $(DELIM)    Compiling $<...$(DELIM)
	$C -DMAC_68K -o $@ $<

pass18080.o : pass1.c token.h token_defs.h structs.h add_defs.h header.h memmgt.h ct.h qual_tbl.h \
  pst_tokens.h pst_structs.h listctrl.h lstcnsts.h strsub.h exproper.h
	$(ECHO) $(DELIM)    Compiling $<...$(DELIM)
	$C -DMAC_8080 -o $@ $<

.PHONY: clean show

clean :
	$(ECHO) $(DELIM)    Cleaning ...$(DELIM)
	$(RM) mac65$(EXE) mac68$(EXE) mac69$(EXE) macas$(EXE) mac68k$(EXE) macpp$(EXE) mactj$(EXE) mac8080$(EXE) mac11$(EXE) mk_operstuff$(EXE) operstuff.h *.o *.b *.d *.E 

show :
	$(ECHO) $(DELIM) ALLO65   = $(ALLO65) $(DELIM)
	$(ECHO) $(DELIM) ALLO68   = $(ALLO68) $(DELIM)
	$(ECHO) $(DELIM) ALLO69   = $(ALLO69) $(DELIM)
	$(ECHO) $(DELIM) ALLO11   = $(ALLO11) $(DELIM)
	$(ECHO) $(DELIM) ALLO8080 = $(ALLO8080) $(DELIM)
	$(ECHO) $(DELIM) ALLOAS   = $(ALLOAS) $(DELIM)
	$(ECHO) $(DELIM) ALLOTJ   = $(ALLOTJ) $(DELIM)
	$(ECHO) $(DELIM) ALLO68K  = $(ALLO68K) $(DELIM)
	$(ECHO) $(DELIM) ALLOPP   = $(ALLOPP) $(DELIM)

